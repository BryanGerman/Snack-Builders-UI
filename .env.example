# Recommended local setup to avoid browser CORS during development.
# GitHub Pages builds must also define VITE_PROXY_TARGET as a repository variable.
# 1) Set VITE_API_BASE_URL=/api
# 2) Set VITE_PROXY_TARGET to your API Gateway base URL
# 3) Run npm run dev
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=xxxx
# Demo JWT secret used by the backend auth.py files.
# Do not use this in production.
VITE_DEMO_JWT_SECRET=xxxx
