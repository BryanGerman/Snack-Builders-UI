# Recommended local setup to avoid browser CORS during development:
# 1) Set VITE_API_BASE_URL=/api
# 2) Set VITE_PROXY_TARGET to your API Gateway base URL
# 3) Run npm run dev
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=https://j6zpaomc2l.execute-api.us-east-1.amazonaws.com

